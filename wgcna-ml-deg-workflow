import matplotlib.pyplot as plt
from matplotlib.patches import Patch

def get_shap_values(model, X, y):
    """Fit on all 42 samples and return class-1 (Basal) SHAP values; a function so the bar
    plot and the beeswarm reuse one fit instead of refitting."""
    fitted = clone(model).fit(X, y)
    return class1_shap(shap.TreeExplainer(fitted).shap_values(X))

sv_all = {n: get_shap_values(searches[n], X, y) for n in SHAP_MODELS}

# direction per gene: mean expression Basal minus rest (positive = higher in Basal)
diff_all = pd.Series(X[y == 1].mean(axis=0) - X[y == 0].mean(axis=0), index=overlap_genes)


def shap_bar(sv, genes, diff, title, ax, top_k=15):
    """Bar of mean |SHAP| coloured by direction; a function so RF and XGB share identical styling."""
    imp = pd.Series(np.abs(sv).mean(axis=0), index=genes).nlargest(top_k)[::-1]
    colors = ["#d62728" if diff[g] > 0 else "#1f77b4" for g in imp.index]
    ax.barh(imp.index, imp.values, color=colors)
    ax.set_xlabel("mean(|SHAP value|)")
    ax.set_title(title)


fig, axes = plt.subplots(1, 2, figsize=(11, 6))
for ax, n in zip(axes, SHAP_MODELS):
    shap_bar(sv_all[n], overlap_genes, diff_all, f"{n}: Basal vs non-Basal", ax)
axes[1].legend(handles=[Patch(color="#d62728", label="higher in Basal"),
                        Patch(color="#1f77b4", label="lower in Basal")], loc="lower right")
plt.tight_layout()
plt.savefig(BASE_DIR + "shap_bar_basal_vs_rest.png", dpi=300)
plt.show()

