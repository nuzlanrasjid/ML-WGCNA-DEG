##  Load libraries
library(WGCNA)
library(fastDummies)

# load data 
df <- read.csv("/content/METABRIC_RNA_Mutation.csv")
dim(df)

## Preprocessing
#split columns: mutation / clinical / gene
pam50_col <- "pam50_._claudin.low_subtype"

cols_mutation <- names(df)[grepl("_mut$", names(df), ignore.case = TRUE)]

cols_clinical <- c(
  "patient_id", "age_at_diagnosis", "type_of_breast_surgery", "cancer_type",
  "cancer_type_detailed", "cellularity", "chemotherapy", pam50_col, "cohort",
  "er_status_measured_by_ihc", "er_status", "neoplasm_histologic_grade",
  "her2_status_measured_by_snp6", "her2_status", "tumor_other_histologic_subtype",
  "hormone_therapy", "inferred_menopausal_state", "integrative_cluster",
  "primary_tumor_laterality", "lymph_nodes_examined_positive", "mutation_count",
  "nottingham_prognostic_index", "oncotree_code", "overall_survival_months",
  "overall_survival", "pr_status", "radio_therapy", "X3.gene_classifier_subtype",
  "tumor_size", "tumor_stage", "death_from_cancer"
)

numeric_col <- sapply(df, is.numeric)
cols_gene <- setdiff(names(df)[numeric_col], c(cols_clinical, cols_mutation))
cat("Gene columns:", length(cols_gene), "\n")   # expected: 489

# expression matrix (samples x genes) and clinical matrix
id_sample <- if ("patient_id" %in% names(df)) "patient_id" else names(df)[1]

df_expr <- df[, cols_gene]
rownames(df_expr) <- df[[id_sample]]

df_clinical <- df[, intersect(cols_clinical, names(df))]
rownames(df_clinical) <- df[[id_sample]]

# data quality check
gsg <- goodSamplesGenes(df_expr, verbose = 3)
gsg$allOK

# choose soft-thresholding power
sft <- pickSoftThreshold(df_expr, powerVector = 1:20, verbose = 5)

plot(sft$fitIndices[, 1], -sign(sft$fitIndices[, 3]) * sft$fitIndices[, 2],
     xlab = "Soft threshold (power)", ylab = "Scale-free topology fit (R^2)",
     main = "Scale independence")
abline(h = 0.90, col = "red")

soft_power <- sft$powerEstimate
cat("Chosen power:", soft_power, "\n")
stopifnot(!is.na(soft_power))   # NA means no power reached the fit threshold; pick one by hand

## Running
# build modules
net <- blockwiseModules(
  df_expr,
  power = soft_power,
  TOMType = "unsigned",
  minModuleSize = 15,
  reassignThreshold = 0,
  mergeCutHeight = 0.25,
  numericLabels = TRUE,
  pamRespectsDendro = FALSE,
  saveTOMs = FALSE,           # TOM file is not used downstream
  verbose = 3
)

moduleColors <- labels2colors(net$colors)
table(moduleColors)

## export gene -> module table (this is what Python will read)
gene_module_df <- data.frame(gene = colnames(df_expr), module = moduleColors)
write.csv(gene_module_df, "/content/metabric_gene_modules_R.csv", row.names = FALSE)

# module-trait relationship (used to justify the 4 modules below)
# Drop "NC" samples. Eigengenes are recomputed on the filtered samples
# so rows of MEs and of the trait table match exactly.
df_clinical_filter <- df_clinical[df_clinical[[pam50_col]] != "NC", ]
df_expr_filtered   <- df_expr[rownames(df_clinical_filter), ]

MEs_filtered <- orderMEs(moduleEigengenes(df_expr_filtered, moduleColors)$eigengenes)

trait_kategori <- dummy_cols(
  df_clinical_filter[pam50_col],
  select_columns = pam50_col,
  remove_selected_columns = TRUE
)
merge_trait <- cbind(df_clinical_filter[, c("tumor_size", "tumor_stage")], trait_kategori)

moduleTraitCor    <- cor(MEs_filtered, merge_trait, use = "pairwise.complete.obs")
# p-values use the number of filtered samples, not the full table
moduleTraitPvalue <- corPvalueStudent(moduleTraitCor, nrow(df_expr_filtered))

textMatrix <- paste(signif(moduleTraitCor, 2), "\n(", signif(moduleTraitPvalue, 1), ")", sep = "")
dim(textMatrix) <- dim(moduleTraitCor)

## Visualization
png("/content/module_trait_relationship.png", width = 1800, height = 1100, res = 150)
par(mar = c(14, 8.5, 3, 3))
labeledHeatmap(
  Matrix = moduleTraitCor, xLabels = names(merge_trait),
  yLabels = names(MEs_filtered), ySymbols = names(MEs_filtered),
  colorLabels = FALSE, colors = blueWhiteRed(50),
  textMatrix = textMatrix, setStdMargins = FALSE, cex.text = 0.5,
  main = "Module-trait relationships"
)
dev.off()

write.csv(data.frame(module = rownames(moduleTraitCor), moduleTraitCor),
          "/content/metabric_module_trait_correlation.csv", row.names = FALSE)
write.csv(data.frame(module = rownames(moduleTraitPvalue), moduleTraitPvalue),
          "/content/metabric_module_trait_pvalue.csv", row.names = FALSE)

