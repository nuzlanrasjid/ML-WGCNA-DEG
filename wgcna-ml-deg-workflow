"""# models + inner tuning"""

def make_search(estimator, grid):
    """One shared inner CV for every model, so tuning is identical and scores are comparable."""
    inner = StratifiedKFold(n_splits=3, shuffle=True, random_state=RANDOM_STATE)
    return GridSearchCV(estimator, grid, cv=inner, scoring="balanced_accuracy", n_jobs=1)

# ---- 4.2 models with FIXED hyperparameters (no inner tuning) ----
# Reason: tuning inside LOO costs ~7x more fits and overfits easily on n=42.
searches = {
