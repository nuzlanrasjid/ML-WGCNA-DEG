"""# SHAP"""

SHAP_MODELS = ["RF", "XGB"]   # SVM skipped: unstable across seeds, KernelExplainer is slow

def class1_shap(sv):
    """Return an (n_samples, n_features) array for the positive class. A function because
    shap gives a list, a 3-D array or a 2-D array depending on version and model."""
    if isinstance(sv, list):
        return np.asarray(sv[1])
    sv = np.asarray(sv)
    return sv[:, :, 1] if sv.ndim == 3 else sv

def shap_importance(model, X, y, genes):
    """Fit on all 42 samples and return mean |SHAP| per gene. A function so RF and XGB
    share one path; no tuning object here, so the fixed-hyperparameter model is fitted directly."""
    fitted = clone(model).fit(X, y)
    sv = class1_shap(shap.TreeExplainer(fitted).shap_values(X))
    out = pd.DataFrame({"gene": genes, "mean_abs_shap": np.abs(sv).mean(axis=0)})
    return out.sort_values("mean_abs_shap", ascending=False).reset_index(drop=True)

importances = {}
for name in SHAP_MODELS:
    importances[name] = shap_importance(searches[name], X, y, overlap_genes)
    importances[name].to_csv(BASE_DIR + f"shap_importance_{name}.csv", index=False)
    print(name, "top genes:", importances[name]["gene"].head(5).tolist())

# consensus: genes in the top-K of ALL SHAP models (RF and XGB)
models = list(importances)
rank_df = pd.DataFrame({m: importances[m].set_index("gene")["mean_abs_shap"].rank(ascending=False)
                        for m in models})
rank_df["n_models_topk"] = (rank_df[models] <= TOP_K_SHAP).sum(axis=1)
rank_df["mean_rank"] = rank_df[models].mean(axis=1)
consensus = (rank_df[rank_df["n_models_topk"] == len(models)]
             .sort_values("mean_rank")
             .rename_axis("gene").reset_index())
consensus.to_csv(BASE_DIR + "shap_consensus_genes.csv", index=False)
