}

"""# nested LOO + permutation test

"""

def nested_loo_score(search, X, y, n_jobs=1):
    """Outer LOO, inner CV tuning. A function so the real labels and every permuted
    labelling go through the exact same procedure (otherwise the null is not comparable)."""
    pred = cross_val_predict(clone(search), X, y, cv=LeaveOneOut(), n_jobs=n_jobs)
    return balanced_accuracy_score(y, pred)

def one_permutation(search, X, y, seed):
    """Top-level function (not a lambda) so joblib can pickle it; seed makes it reproducible."""
    y_perm = np.random.RandomState(seed).permutation(y)
    return nested_loo_score(search, X, y_perm, n_jobs=1)

def permutation_null(search, X, y, n_perm):
    """Parallelise over permutations (few big jobs) instead of over LOO folds (many tiny jobs)."""
    seeds = np.random.RandomState(RANDOM_STATE).randint(0, 2**31 - 1, size=n_perm)
    return np.array(Parallel(n_jobs=-1)(delayed(one_permutation)(search, X, y, s) for s in seeds))

rows = []
for name, search in searches.items():
    obs = nested_loo_score(search, X, y, n_jobs=-1)
    null = permutation_null(search, X, y, N_PERM)
    p_val = (1 + np.sum(null >= obs)) / (N_PERM + 1)    # +1: a permutation p-value is never exactly 0
    rows.append({"model": name, "balanced_accuracy": round(obs, 3),
                 "null_mean": round(null.mean(), 3), "null_std": round(null.std(), 3),
                 "p_perm": round(p_val, 4), "n_perm": N_PERM,
                 "n_samples": len(y), "n_features": X.shape[1]})
