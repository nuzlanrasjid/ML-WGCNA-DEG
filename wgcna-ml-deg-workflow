def loo_confusion(model, X, y):
    """LOO predictions -> sensitivity/specificity; a function so all models report identically."""
    pred = cross_val_predict(clone(model), X, y, cv=LeaveOneOut(), n_jobs=-1)
    tn, fp, fn, tp = confusion_matrix(y, pred).ravel()
    return {"TP": tp, "FN": fn, "TN": tn, "FP": fp,
            "sens": round(tp / (tp + fn), 3), "spec": round(tn / (tn + fp), 3)}

for name, m in searches.items():
    print(name, loo_confusion(m, X, y))

def subsample_score(model, seed):
    """Redraw the 6 vs 36 subsample with a new seed; a function so every seed runs identical steps."""
    idx = np.concatenate([
        df_ml[is_target].sample(n=N_MINORITY, random_state=seed).index,
        df_ml[~is_target].sample(n=N_MAJORITY, random_state=seed).index])
    Xs = df_ml.loc[idx, overlap_genes].to_numpy(dtype=float)
    ys = (df_ml.loc[idx, pam50_col] == TARGET_CLASS).astype(int).to_numpy()
    return nested_loo_score(model, Xs, ys, n_jobs=-1)

