is_sig = (dp["padj_mannwhitney"] < SIG_PADJ) & (dp["mean_diff_zscore"].abs() > MIN_EFFECT)
is_up = is_sig & (dp["mean_diff_zscore"] > 0)
is_down = is_sig & (dp["mean_diff_zscore"] < 0)

plt.figure(figsize=(8, 6))
for mask, color, label in [(~is_sig, "lightgrey", "Not significant"),
