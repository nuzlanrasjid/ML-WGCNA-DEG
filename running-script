plt.axvline(MIN_EFFECT, color="grey", linestyle="--", linewidth=1)
plt.axvline(-MIN_EFFECT, color="grey", linestyle="--", linewidth=1)
for g_name in ["gata3", "egfr"]:                        # visual cross-check with earlier SHAP candidates
    r = dp[dp["gene"] == g_name]
