print(df_ml[pam50_col].value_counts())
print("Samples after NA removal:", df_ml.shape[0])       # earlier run: 1,699

# ---- [PYTHON] DGE ----
# Mann-Whitney is the main test (z-scores are not guaranteed normal); Welch t-test
# is reported alongside. DESeq2/limma-voom are not used: they need raw counts, and
# METABRIC values are already z-scores, so log2FC is undefined and the raw mean
# difference is the effect size.
is_basal = df_ml[pam50_col] == TARGET_CLASS
group_basal = df_ml.loc[is_basal, cols_gene_all]
group_rest = df_ml.loc[~is_basal, cols_gene_all]
print(f"{TARGET_CLASS}: {len(group_basal)} | rest: {len(group_rest)}")

rows = []
for gene in cols_gene_all:
    a, b = group_basal[gene], group_rest[gene]
    rows.append({
        "gene": gene,
        "mean_basal": a.mean(),
        "mean_non_basal": b.mean(),
        "mean_diff_zscore": a.mean() - b.mean(),
        "p_ttest": stats.ttest_ind(a, b, equal_var=False)[1],
        "p_mannwhitney": stats.mannwhitneyu(a, b, alternative="two-sided")[1],
    })

dge_result = pd.DataFrame(rows)
# Benjamini-Hochberg: ~489 tests would give ~24 false positives at raw p<0.05
dge_result["padj_ttest"] = multipletests(dge_result["p_ttest"], method="fdr_bh")[1]
dge_result["padj_mannwhitney"] = multipletests(dge_result["p_mannwhitney"], method="fdr_bh")[1]
dge_result = dge_result.sort_values("padj_mannwhitney")

deg_significant = dge_result[
    (dge_result["padj_mannwhitney"] < SIG_PADJ) &
    (dge_result["mean_diff_zscore"].abs() > MIN_EFFECT)
].copy()
print(f"Tested: {len(dge_result)} | significant DEG: {len(deg_significant)}")   # earlier run: 165
print(deg_significant[["gene", "mean_diff_zscore", "p_mannwhitney"]].head(10))

dge_result.to_csv(BASE_DIR + "dge_basal_vs_rest_all.csv", index=False)
deg_significant.to_csv(BASE_DIR + "dge_basal_vs_rest_significant.csv", index=False)

# ---- [PYTHON] volcano plot ----
dp = dge_result.copy()
