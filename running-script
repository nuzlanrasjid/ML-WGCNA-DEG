df = pd.read_csv(BASE_DIR + "METABRIC_RNA_Mutation.csv", low_memory=False)
print(df_gene_module.shape, df.shape)

import re

def restore_gene_names(r_names, original_columns):
    """R's read.csv rewrites column names (make.names): 'hla-g' -> 'hla.g', '3x' -> 'X3x'.
    Map the names in the WGCNA table back to the original CSV headers. A function because
    it is needed here (step 2/3) and again in the standalone step 4.0. Without it, genes with
    rewritten names silently fail to match in the DEG x WGCNA intersection."""
    lookup = {}
    for col in original_columns:
        r_name = re.sub(r"[^A-Za-z0-9._]", ".", col)
        if not re.match(r"^([A-Za-z]|\.(?![0-9]))", r_name):
            r_name = "X" + r_name
        lookup[r_name] = col
    return [lookup.get(g, g) for g in r_names]

n_before = df_gene_module["gene"].copy()
df_gene_module["gene"] = restore_gene_names(df_gene_module["gene"], df.columns)
print("Gene names restored:", (n_before != df_gene_module["gene"]).sum())
unmatched = [g for g in df_gene_module["gene"] if g not in df.columns]
