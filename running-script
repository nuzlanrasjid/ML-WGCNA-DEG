                     fontsize=9, fontweight="bold")
plt.xlabel("Mean difference (z-score, Basal - rest)")
plt.ylabel("-log10(padj, Mann-Whitney)")
plt.title("Volcano plot: Basal vs non-Basal (METABRIC)")
plt.legend()
